diff --git a/supabase/.sb.env.example b/supabase/.sb.env.example
index b90844d..839bdbc 100644
--- a/supabase/.sb.env.example
+++ b/supabase/.sb.env.example
@@ -93,3 +93,18 @@ MUSE_SPARK_MODEL=
 # FR-MOD-03).
 # Default: muse-spark (all-Meta demo runtime, FR-MOD-02a)
 EXTRACTION_PROVIDER=
+
+# --- Video pipeline (FR-VID) ---
+
+# Public HTTPS URL of the deployed Modal video endpoint
+# (modal deploy modal/video_pipeline.py — owner only, consumes credits).
+# Used by: process-video-document (hands rack videos to Modal, returns
+# immediately; Modal writes results back to Supabase).
+# Without it, process-video-document returns 500 "Video pipeline unavailable".
+MODAL_VIDEO_ENDPOINT_URL=
+
+# Shared secret authenticating both directions of the video pipeline:
+# edge → Modal handoff AND Modal → extract-isolated-item callbacks.
+# Generate with: openssl rand -hex 32
+# Set in BOTH supabase secrets AND the Modal secret (snaplog-video).
+VIDEO_CALLBACK_SECRET=
